<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring.mapper.CategoryMapper">
  <resultMap id="categoryWithLearningData" type="com.spring.entity.Category">
    <id property="id" column="category_id"/>
    <result property="name" column="category_name"/>
    <collection property="learningDataList" ofType="com.spring.entity.LearningData">
      <id property="id" column="learning_data_id"/>
      <result property="itemName" column="item_name"/>
      <result property="learningTime" column="learning_time"/>
    </collection>
  </resultMap>

  <select id="findWithLearningDataByMonth" resultMap="categoryWithLearningData">
    SELECT
      c.id AS category_id,
      c.name AS category_name,
      l.id AS learning_data_id,
      l.item_name AS item_name,
      l.learning_time AS learning_time
    FROM categories c
    LEFT JOIN learning_data l
      ON l.category_id = c.id
      AND l.user_id = #{userId}
      AND l.learning_month = #{month}
    ORDER BY c.id, l.id
  </select>
</mapper>